void logToSheets(float temperature, bool heaterOn, bool alertMuted, unsigned long runtimeMinutes) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected, skipping Sheets log");
    return;
  }

  WiFiSSLClient client;
  client.setTimeout(10000);

  String url = "/macros/s/AKfycbxKzS4Vm4CsIasPJKofIUxkaWy-sidcOJSvTR0M_6gP6Bt26OaKQUkz3QxF8xq6uauC/exec";
  url += "?temperature=" + String(temperature, 1);
  url += "&heaterStatus=" + String(heaterOn ? "ON" : "OFF");
  url += "&alertMuted=" + String(alertMuted ? "true" : "false");
  url += "&runtimeMinutes=" + String(runtimeMinutes);

  Serial.println("Connecting to Sheets...");

  if (!client.connect("script.google.com", 443)) {
    Serial.println("Connection failed");
    return;
  }

  client.println("GET " + url + " HTTP/1.1");
  client.println("Host: script.google.com");
  client.println("Connection: close");
  client.println();

  unsigned long timeout = millis();
  while (client.available() == 0) {
    if (millis() - timeout > 10000) {
      Serial.println("Sheets timeout");
      client.stop();
      return;
    }
  }

  String response = client.readStringUntil('\n');
  Serial.println("Sheets: " + response);
  client.stop();
}

